# Only needed for the admin panel and self-hosted lesson videos/PDFs.
# The public site (roadmaps, courses with YouTube lessons) runs without any of this.

# S3-compatible storage (Cloudflare R2, MinIO, AWS S3)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Bearer secret for /api/admin and /api/videos upload routes
ADMIN_SECRET=
